# AgriFlow Environment Variables
# Copy this to .env and fill in your actual credentials

# Twilio (WhatsApp Integration)
# Get from: twilio.com/console
TWILIO_SID=your_twilio_account_sid
TWILIO_TOKEN=your_twilio_auth_token
TWILIO_PHONE=whatsapp:+14155238886

# Sentinel Hub (Satellite NDVI Data)
# Optional - for real NDVI calculations
SENTINEL_HUB_API=your_sentinel_hub_api_key
SENTINEL_HUB_CLIENT_ID=your_client_id
SENTINEL_HUB_CLIENT_SECRET=your_client_secret

# RazorpayX (UPI Payments)
# Get from: razorpay.com
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxx

# FastAPI Server
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Database (SQLite for dev, PostgreSQL for prod)
DATABASE_URL=sqlite:///./data/agriflow.db
# DATABASE_URL=postgresql://user:password@localhost/agriflow
